macos-titlebar-style = hidden
macos-icon = retro
confirm-close-surface = false

command = /bin/zsh --login -c 'tmux attach || tmux new -s base; exec zsh'

font-size = 13.5
theme = argonaut
font-family = "DejaVuSansM Nerd Font"
font-family = "DejaVu Sans Mono for Powerline"

keybind = shift+enter=text:\x1b\r
macos-option-as-alt=true

# machine-specific overrides, not tracked in dotfiles
config-file = ?~/.config/ghostty/local.ghostty
# on British macs with the Karabiner option-3 rule enabled, add in local.ghostty:
# Karabiner sends option+3 for # (British layout); with option-as-alt it would arrive as alt+3
# keybind = alt+digit_3=text:#
